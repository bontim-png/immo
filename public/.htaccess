# LiteSpeed compatible rewrite rules

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Don't rewrite requests for existing files or directories
    RewriteCond %{DOCUMENT_ROOT}/immobilier/public/%{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/immobilier/public/%{REQUEST_FILENAME} !-d
    
    # Don't rewrite index.php itself (prevents infinite loop)
    RewriteCond %{REQUEST_FILENAME} !index\.php
    
    # Rewrite everything else to index.php
    RewriteRule ^(.*)$ /immobilier/public/index.php [QSA,L]
</IfModule>

# Allow access to all PHP files
<FilesMatch "\.php$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Deny access to dotfiles
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Compress responses
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/json
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
</IfModule>
