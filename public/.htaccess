# LiteSpeed compatible rewrite rules
# Remove all other rewrite rules temporarily for testing

DirectoryIndex index.php

# First, make sure index.php can be accessed directly
# If this doesn't work, the problem is NOT with .htaccess

# For LiteSpeed, we need to be very explicit
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Check if the request is for an actual file that exists
    RewriteCond %{DOCUMENT_ROOT}/immobilier/public/%{REQUEST_FILENAME} !-f
    # Check if the request is for an actual directory that exists  
    RewriteCond %{DOCUMENT_ROOT}/immobilier/public/%{REQUEST_FILENAME} !-d
    # If not an existing file or directory, send to index.php
    RewriteRule ^(.*)$ /immobilier/public/index.php [QSA,L]
</IfModule>

# Allow access to index.php explicitly
<Files "index.php">
    Order allow,deny
    Allow from all
</Files>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Deny access to dotfiles
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
